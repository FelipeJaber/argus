# Variáveis do perfil prod (PostgreSQL): --spring.profiles.active=prod. Copie para .env e NÃO versione o .env.
DB_URL=jdbc:postgresql://localhost:5432/argus
DB_USERNAME=argus
DB_PASSWORD=argus
# Gere com: openssl rand -base64 48
ARGUS_JWT_SECRET=
# Origens do frontend, separadas por vírgula
ARGUS_CORS_ORIGINS=http://localhost:5173
# Atrás de proxy reverso/HTTPS: framework
FORWARD_HEADERS_STRATEGY=none
